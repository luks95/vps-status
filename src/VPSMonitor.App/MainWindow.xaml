<Window x:Class="VPSMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="VPS Monitor"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="WindowLoaded"
        Closing="WindowClosing">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="22,22,16,18">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#193E52">
                        <TextBlock Text="&#xE9F9;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="18"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VPS Monitor" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Linux · SSH" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <Button Style="{StaticResource NavButton}" Background="{Binding CurrentPage, Converter={StaticResource PageSelectionBrushConverter}, ConverterParameter=Resumen}" Command="{Binding NavigateCommand}" CommandParameter="Resumen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" Width="28" FontSize="16" />
                            <TextBlock Text="Resumen" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Background="{Binding CurrentPage, Converter={StaticResource PageSelectionBrushConverter}, ConverterParameter=Servidores}" Command="{Binding NavigateCommand}" CommandParameter="Servidores">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" Width="28" FontSize="16" />
                            <TextBlock Text="Servidores" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Background="{Binding CurrentPage, Converter={StaticResource PageSelectionBrushConverter}, ConverterParameter=Alertas}" Command="{Binding NavigateCommand}" CommandParameter="Alertas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons" Width="28" FontSize="16" />
                            <TextBlock Text="Alertas" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Background="{Binding CurrentPage, Converter={StaticResource PageSelectionBrushConverter}, ConverterParameter=Configuración}" Command="{Binding NavigateCommand}" CommandParameter="Configuración">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Width="28" FontSize="16" />
                            <TextBlock Text="Configuración" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="2" Margin="20,0,14,10">
                    <TextBlock Text="SERVIDORES" Style="{StaticResource MutedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Style="{StaticResource ButtonBase}"
                            ToolTip="Agregar VPS"
                            AutomationProperties.Name="Agregar VPS"
                            Click="AddServerClicked">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    </Button>
                </Grid>

                <ListBox Grid.Row="3"
                         Margin="8,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Servers}"
                         SelectedItem="{Binding SelectedServer}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Padding="12,10"
                                                CornerRadius="6"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#193047" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#275C82" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#19222C" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#66B5FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#27313B">
                                    <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,4,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Endpoint}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Ellipse Grid.Column="2"
                                         Width="9"
                                         Height="9"
                                         Fill="{Binding StatusColor}"
                                         ToolTip="{Binding StatusLabel}"
                                         AutomationProperties.Name="{Binding StatusLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="16" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Solo monitoreo" FontWeight="SemiBold" />
                            <TextBlock Text="Comandos fijos de lectura" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="32,20"
                    Background="#0D1218"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Monitoreo seguro y en tiempo real" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="EditServerButton"
                                Margin="0,0,8,0"
                                Style="{StaticResource ButtonBase}"
                                Content="Editar"
                                IsEnabled="{Binding HasSelection}"
                                Click="EditServerClicked" />
                        <Button Style="{StaticResource PrimaryButton}" Click="AddServerClicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                <TextBlock Text="Agregar VPS" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Background="{StaticResource WindowBackgroundBrush}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="32,26,32,36">
                    <Border x:Name="Banner"
                            VerticalAlignment="Top"
                            Padding="12"
                            CornerRadius="6"
                            Background="#3B2B15"
                            BorderBrush="#805A20"
                            BorderThickness="1"
                            Panel.ZIndex="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BannerMessage}" Foreground="#FFD38A" />
                    </Border>

                    <Grid Visibility="{Binding IsSummaryPage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="En línea" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding OnlineCount}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="Con advertencias" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding WarningCount}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Sin conexión" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding OfflineCount}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Estado de servidores" FontSize="18" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Servers}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="{Binding CpuText, StringFormat=CPU {0}}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsServersPage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel DataContext="{Binding SelectedServer}">
                                <Grid Margin="0,0,0,18">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                            <Border Margin="12,2,0,0" Padding="10,4" CornerRadius="5" Background="#173528">
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Endpoint}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding DistributionText}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DangerButton}"
                                            Content="Eliminar VPS"
                                            Click="DeleteServerClicked" />
                                </Grid>

                                <UniformGrid Columns="5" Margin="0,0,0,14">
                                    <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                                        <StackPanel><TextBlock Text="Uptime" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding UptimeText}" FontSize="23" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="3,0">
                                        <StackPanel><TextBlock Text="Carga" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding LoadText}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding LoadDetails}" Style="{StaticResource MutedText}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="3,0">
                                        <StackPanel><TextBlock Text="Procesos" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ProcessesText}" FontSize="23" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="3,0">
                                        <StackPanel><TextBlock Text="Temperatura" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding TemperatureText}" FontSize="23" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                                        <StackPanel><TextBlock Text="SSH" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding StatusLabel}" FontSize="19" FontWeight="SemiBold" Foreground="{Binding StatusColor}" /><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" /></StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="240" /></Grid.RowDefinitions>
                                            <Grid><TextBlock Text="CPU" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right" FontSize="22" Foreground="{StaticResource AccentBrush}" /></Grid>
                                            <lvc:CartesianChart Grid.Row="1" Margin="0,10,0,0" Series="{Binding CpuSeries}" XAxes="{Binding TimeXAxes}" YAxes="{Binding PercentageYAxes}" LegendPosition="Hidden" AutomationProperties.Name="{Binding ChartSummary}" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="240" /></Grid.RowDefinitions>
                                            <Grid><TextBlock Text="Memoria" FontSize="17" FontWeight="SemiBold" /><StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding MemoryText}" FontSize="17" Foreground="{StaticResource AccentBlueBrush}" /><TextBlock Text="{Binding MemoryPercentText}" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></StackPanel></Grid>
                                            <lvc:CartesianChart Grid.Row="1" Margin="0,10,0,0" Series="{Binding MemorySeries}" XAxes="{Binding TimeXAxes}" YAxes="{Binding PercentageYAxes}" LegendPosition="Hidden" AutomationProperties.Name="Gráfica de memoria de los últimos 60 segundos" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                                        <StackPanel>
                                            <Grid><TextBlock Text="Disco" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding DiskPercentText}" HorizontalAlignment="Right" FontSize="22" Foreground="{StaticResource WarningBrush}" /></Grid>
                                            <TextBlock Text="{Binding DiskText}" Margin="0,22,0,8" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ProgressBar Value="{Binding DiskPercent}" Maximum="100" />
                                            <TextBlock Text="Sistema de archivos raíz" Margin="0,12,0,0" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="190" /></Grid.RowDefinitions>
                                            <Grid><TextBlock Text="Red" FontSize="17" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding NetworkReceiveText}" Foreground="{StaticResource AccentBlueBrush}" /><TextBlock Text="   " /><TextBlock Text="{Binding NetworkTransmitText}" Foreground="{StaticResource AccentBrush}" /></StackPanel></Grid>
                                            <lvc:CartesianChart Grid.Row="1" Margin="0,10,0,0" Series="{Binding NetworkSeries}" XAxes="{Binding TimeXAxes}" YAxes="{Binding RateYAxes}" LegendPosition="Bottom" AutomationProperties.Name="Gráfica de red de los últimos 60 segundos" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="190" /></Grid.RowDefinitions>
                                            <Grid><TextBlock Text="Latencia" FontSize="17" FontWeight="SemiBold" /><StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding LatencyText}" FontSize="19" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="{Binding LatencyMethodText}" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></StackPanel></Grid>
                                            <lvc:CartesianChart Grid.Row="1" Margin="0,10,0,0" Series="{Binding LatencySeries}" XAxes="{Binding TimeXAxes}" YAxes="{Binding LatencyYAxes}" LegendPosition="Hidden" AutomationProperties.Name="Gráfica de latencia de los últimos 60 segundos" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="520">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Agrega tu primera VPS" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                <TextBlock Text="Necesitarás la IP, el usuario SSH y la contraseña." Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,8,0,18" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Agregar VPS" Click="AddServerClicked" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsAlertsPage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Las alertas de esta sesión aparecen aquí. No se guarda historial." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                <Ellipse Width="9" Height="9" Fill="{StaticResource WarningBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ServerName}" Margin="10,0" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Time}" HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No hay alertas en esta sesión."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAlerts}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="560" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Límites globales" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Se aplican a todas las VPS salvo que una tenga valores propios." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,20" />
                                <TextBlock Text="CPU (%)" FontWeight="SemiBold" /><TextBox Text="{Binding CpuThreshold, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,14" />
                                <TextBlock Text="Memoria (%)" FontWeight="SemiBold" /><TextBox Text="{Binding MemoryThreshold, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,14" />
                                <TextBlock Text="Disco (%)" FontWeight="SemiBold" /><TextBox Text="{Binding DiskThreshold, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,14" />
                                <TextBlock Text="Latencia (ms)" FontWeight="SemiBold" /><TextBox Text="{Binding LatencyThreshold, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,20" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Guardar configuración" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
