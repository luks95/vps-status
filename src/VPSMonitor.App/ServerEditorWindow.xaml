<Window x:Class="VPSMonitor.App.ServerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar VPS"
        Width="660"
        Height="800"
        MinWidth="600"
        MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Padding="28,22" Background="#0D1218" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="10" Background="#193E52">
                    <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" Text="Agregar VPS" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Conexión SSH de solo lectura; no se ejecutan comandos propios." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Formulario con scroll: nunca recorta campos en pantallas pequeñas -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,10">

                <!-- Servidor -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Servidor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

                        <TextBlock Text="Nombre visible" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Margin="0,6,0,14" TextChanged="AnyFieldChanged" AutomationProperties.Name="Nombre visible" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="IP o dominio" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HostBox" Margin="0,6,0,0" TextChanged="AnyFieldChanged" AutomationProperties.Name="IP o dominio" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Puerto" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PortBox" Margin="0,6,0,0" Text="22" TextChanged="AnyFieldChanged" AutomationProperties.Name="Puerto SSH" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Autenticación -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Autenticación" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

                        <TextBlock Text="Usuario SSH" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UsernameBox" Margin="0,6,0,16" TextChanged="AnyFieldChanged" AutomationProperties.Name="Usuario SSH" />

                        <TextBlock Text="Método" Style="{StaticResource FieldLabel}" />
                        <Border Margin="0,6,0,16" Padding="3" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="PasswordRadio"
                                             GroupName="AuthMethod"
                                             Style="{StaticResource SegmentedRadio}"
                                             Tag="&#xE72E;"
                                             Content="Contraseña"
                                             IsChecked="True"
                                             Checked="AuthMethodChanged"
                                             AutomationProperties.Name="Autenticar con contraseña" />
                                <RadioButton x:Name="KeyRadio"
                                             GroupName="AuthMethod"
                                             Style="{StaticResource SegmentedRadio}"
                                             Tag="&#xE192;"
                                             Content="Clave SSH"
                                             Checked="AuthMethodChanged"
                                             AutomationProperties.Name="Autenticar con clave SSH" />
                            </UniformGrid>
                        </Border>

                        <!-- Contraseña -->
                        <StackPanel x:Name="PasswordPanel">
                            <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="PasswordInput" Margin="0,6,0,6" PasswordChanged="AnyPasswordChanged" AutomationProperties.Name="Contraseña SSH" />
                            <TextBlock x:Name="PasswordHint" Style="{StaticResource MutedText}" Text="Se guardará cifrada mediante Credential Manager de Windows." />
                        </StackPanel>

                        <!-- Clave privada -->
                        <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                            <TextBlock Text="Archivo de clave privada" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="KeyPathBox" TextChanged="AnyFieldChanged" AutomationProperties.Name="Ruta de la clave privada" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource ButtonBase}"
                                        Click="BrowseKeyClicked"
                                        AutomationProperties.Name="Examinar archivo de clave">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8DA;" FontFamily="Segoe Fluent Icons" Margin="0,1,8,0" />
                                        <TextBlock Text="Examinar" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="Por ejemplo, id_ed25519 o id_rsa en tu carpeta .ssh. Se admiten claves OpenSSH y PEM; los archivos .ppk de PuTTY no son compatibles." />

                            <TextBlock Text="Passphrase (opcional)" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                            <PasswordBox x:Name="PassphraseInput" Margin="0,6,0,6" PasswordChanged="AnyPasswordChanged" AutomationProperties.Name="Passphrase de la clave" />
                            <TextBlock x:Name="PassphraseHint" Style="{StaticResource MutedText}" Text="Solo si tu clave está protegida. Se guarda en Credential Manager de Windows." />

                            <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6" Background="#12221F" BorderBrush="#1F4A44" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="Solo se guarda la ruta del archivo; la clave privada nunca se copia ni se almacena en la aplicación." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Opciones -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,8">
                    <StackPanel>
                        <TextBlock Text="Opciones" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <CheckBox x:Name="EnabledCheckBox"
                                  IsChecked="True"
                                  Content="Monitorear automáticamente" />

                        <CheckBox x:Name="CustomThresholdsCheckBox"
                                  Margin="0,6,0,0"
                                  Content="Usar límites de alerta propios"
                                  Checked="CustomThresholdsChanged"
                                  Unchecked="CustomThresholdsChanged" />

                        <Grid x:Name="CustomThresholdPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="CPU %" Style="{StaticResource MutedText}" />
                                <TextBox x:Name="CpuThresholdBox" Text="90" Margin="0,4,0,0" AutomationProperties.Name="Límite de CPU" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0">
                                <TextBlock Text="Memoria %" Style="{StaticResource MutedText}" />
                                <TextBox x:Name="MemoryThresholdBox" Text="85" Margin="0,4,0,0" AutomationProperties.Name="Límite de memoria" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0">
                                <TextBlock Text="Disco %" Style="{StaticResource MutedText}" />
                                <TextBox x:Name="DiskThresholdBox" Text="80" Margin="0,4,0,0" AutomationProperties.Name="Límite de disco" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                <TextBlock Text="Latencia ms" Style="{StaticResource MutedText}" />
                                <TextBox x:Name="LatencyThresholdBox" Text="200" Margin="0,4,0,0" AutomationProperties.Name="Límite de latencia" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Pie fijo: estado, confirmación de huella y acciones siempre visibles -->
        <Border Grid.Row="2" Padding="28,14,28,20" Background="#0D1218" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- Aprobación de huella del servidor -->
                <Border x:Name="FingerprintPanel"
                        Visibility="Collapsed"
                        Padding="14"
                        Margin="0,0,0,12"
                        CornerRadius="6"
                        Background="#3B2B15"
                        BorderBrush="#805A20"
                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FingerprintIcon" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource WarningBrush}" Margin="0,2,10,0" />
                            <TextBlock x:Name="FingerprintTitle" Text="Confirma la identidad del servidor" FontWeight="SemiBold" Foreground="#FFD38A" />
                        </StackPanel>
                        <TextBlock x:Name="FingerprintDescription"
                                   Margin="0,6,0,8"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Es la primera conexión con este servidor. Compara la huella con la que muestra tu proveedor." />
                        <TextBox x:Name="FingerprintBox"
                                 IsReadOnly="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="13"
                                 AutomationProperties.Name="Huella SSH presentada" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="TrustButton" Style="{StaticResource PrimaryButton}" Content="Confiar y continuar" Click="TrustFingerprintClicked" />
                            <Button Margin="8,0,0,0" Style="{StaticResource ButtonBase}" Content="Rechazar" Click="RejectFingerprintClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Resultado de la prueba -->
                <Border x:Name="ResultPanel"
                        Visibility="Collapsed"
                        Padding="12,10"
                        Margin="0,0,0,12"
                        CornerRadius="6"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ResultIcon" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="ResultText" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationText"
                           Margin="0,0,0,12"
                           Foreground="{StaticResource CriticalBrush}"
                           AutomationProperties.LiveSetting="Assertive" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TestButton"
                            Style="{StaticResource ButtonBase}"
                            IsDefault="True"
                            Click="TestConnectionClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" Margin="0,1,8,0" />
                            <TextBlock Text="Probar conexión" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Margin="0,0,10,0"
                            Style="{StaticResource ButtonBase}"
                            Content="Cancelar"
                            IsCancel="True" />
                    <Button x:Name="SaveButton"
                            Grid.Column="3"
                            MinHeight="44"
                            Style="{StaticResource PrimaryButton}"
                            Content="Guardar VPS"
                            Click="SaveClicked" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
